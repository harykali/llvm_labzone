{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "process",
            "command": "/opt/homebrew/bin/cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DLLVM_DIR=/opt/homebrew/opt/llvm/lib/cmake/llvm",
                "-DCMAKE_MAKE_PROGRAM=/opt/homebrew/bin/ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build llvm_variable",
            "type": "process",
            "command": "/opt/homebrew/bin/cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "llvm_variable"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "configure",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
